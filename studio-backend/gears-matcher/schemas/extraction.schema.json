{
  "$defs": {
    "Clarification": {
      "description": "A topic to ask the spec's author about (#65, T8 note D11): too vague, or missing.\n\nThe model's words: bounded, and shown escaped. `quote` is a passage of the spec, verified in\nthe document when given; None means an absence (\"nothing says how users sign in\").",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "reason",
        "quote",
        "path"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "DocumentOutcome": {
      "description": "`DocumentExtraction` for one document, with what only the review sheet shows.",
      "properties": {
        "chunks": {
          "title": "Chunks",
          "type": "integer"
        },
        "chunks_failed": {
          "title": "Chunks Failed",
          "type": "integer"
        },
        "dropped": {
          "title": "Dropped",
          "type": "integer"
        },
        "incomplete": {
          "title": "Incomplete",
          "type": "boolean"
        },
        "kept": {
          "title": "Kept",
          "type": "integer"
        },
        "merged": {
          "title": "Merged",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "shaped_blocks": {
          "title": "Shaped Blocks",
          "type": "integer"
        },
        "strong_blocks": {
          "title": "Strong Blocks",
          "type": "integer"
        },
        "unclaimed_blocks": {
          "title": "Unclaimed Blocks",
          "type": "integer"
        },
        "unclaimed_examples": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unclaimed Examples",
          "type": "array"
        },
        "unclaimed_strong": {
          "title": "Unclaimed Strong",
          "type": "integer"
        }
      },
      "required": [
        "kept",
        "dropped",
        "merged",
        "shaped_blocks",
        "unclaimed_blocks",
        "strong_blocks",
        "unclaimed_strong",
        "chunks",
        "chunks_failed",
        "incomplete",
        "reason",
        "path"
      ],
      "title": "DocumentOutcome",
      "type": "object"
    },
    "Dropped": {
      "description": "A model item thrown away, with why. `item` is cut to 200 characters and shown escaped.",
      "properties": {
        "item": {
          "title": "Item",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "reason",
        "item"
      ],
      "title": "Dropped",
      "type": "object"
    },
    "Extracted": {
      "properties": {
        "names_gear": {
          "items": {
            "type": "string"
          },
          "title": "Names Gear",
          "type": "array"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "requirement": {
          "$ref": "#/$defs/Requirement"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "spec_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spec Id"
        }
      },
      "required": [
        "requirement",
        "span",
        "quote",
        "spec_id",
        "names_gear"
      ],
      "title": "Extracted",
      "type": "object"
    },
    "ExtractionReport": {
      "properties": {
        "cache_hits": {
          "title": "Cache Hits",
          "type": "integer"
        },
        "calls": {
          "title": "Calls",
          "type": "integer"
        },
        "chunks": {
          "title": "Chunks",
          "type": "integer"
        },
        "chunks_failed": {
          "title": "Chunks Failed",
          "type": "integer"
        },
        "dropped": {
          "items": {
            "$ref": "#/$defs/Dropped"
          },
          "title": "Dropped",
          "type": "array"
        },
        "dropped_total": {
          "title": "Dropped Total",
          "type": "integer"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "unclaimed_blocks": {
          "title": "Unclaimed Blocks",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "prompt_version",
        "chunks",
        "chunks_failed",
        "cache_hits",
        "calls",
        "input_tokens",
        "output_tokens",
        "dropped",
        "dropped_total",
        "unclaimed_blocks"
      ],
      "title": "ExtractionReport",
      "type": "object"
    },
    "Issue": {
      "description": "One parse-report finding: `error` means something is wrong, `info` is a fact to know.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Where"
        }
      },
      "required": [
        "severity",
        "kind",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Requirement": {
      "description": "One CF requirement from a spec: the left-hand side of every match.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fr",
            "nfr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "must_level": {
          "anyOf": [
            {
              "enum": [
                "MUST",
                "MUST NOT",
                "SHALL",
                "SHALL NOT",
                "SHOULD",
                "SHOULD NOT",
                "MAY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Must Level"
        },
        "origin": {
          "default": "template",
          "enum": [
            "template",
            "extracted"
          ],
          "title": "Origin",
          "type": "string"
        },
        "planned": {
          "title": "Planned",
          "type": "boolean"
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Priority"
        },
        "source": {
          "$ref": "#/$defs/SpecRef"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "kind",
        "must_level",
        "priority",
        "planned",
        "source"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "Span": {
      "description": "Where in a document: character offsets into `Document.text`, end exclusive.",
      "properties": {
        "end": {
          "title": "End",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    },
    "SpecRef": {
      "description": "Where a requirement is defined: spec file, 1-based line of its ID, and its heading path.",
      "properties": {
        "end_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "SpecRef",
      "type": "object"
    }
  },
  "properties": {
    "clarifications": {
      "items": {
        "$ref": "#/$defs/Clarification"
      },
      "title": "Clarifications",
      "type": "array"
    },
    "extracted": {
      "items": {
        "$ref": "#/$defs/Extracted"
      },
      "title": "Extracted",
      "type": "array"
    },
    "gear_gdl_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gear Gdl Commit"
    },
    "gears_md_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gears Md Commit"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/DocumentOutcome"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "product_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Id"
    },
    "report": {
      "$ref": "#/$defs/ExtractionReport"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "extracted",
    "clarifications",
    "outcomes",
    "report"
  ],
  "title": "Extraction",
  "type": "object"
}
